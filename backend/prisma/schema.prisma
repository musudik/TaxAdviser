// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String // 'admin', 'tax_agent', 'client'
  phone     String?
  active    Boolean  @default(true)
}

model TaxReturn {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clientId   String
  partnerId  String
  type       String?
  status     String   @default("draft") // draft, submitted, processing, completed, rejected
  
  // Store JSON data for each section
  personalInfo Json
  children     Json?
  incomeInfo   Json
  deductions   Json
  taxCredits   Json
  signature    Json?
  
  // Optional JSON fields for additional metadata
  metadata     Json?

  // Statistics and dates
  submittedAt  DateTime?
} 