// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      String // 'admin', 'tax_agent', 'client'
  phone     String?
  active    Boolean  @default(true)
}

model TaxReturn {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  clientId   String
  partnerId  String
  type       String?
  status     String   @default("draft") // draft, submitted, processing, completed, rejected
  
  // Store JSON data for each section
  personalInfo Json
  children     Json?
  incomeInfo   Json
  deductions   Json
  taxCredits   Json
  signature    Json?
  
  // Optional JSON fields for additional metadata
  metadata     Json?

  // Statistics and dates
  submittedAt  DateTime?
}

model TaxForm {
  id             String    @id @default(uuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  applicationId  String    @unique // Unique application ID for reference
  userId         String?   // Optional connection to user
  currentStep    Int       @default(0)
  status         String    @default("draft") // draft, submitted, processing, completed, rejected
  
  // Key fields for filtering extracted from JSON data
  firstName      String?
  lastName       String?
  submissionYear String?
  
  // Store JSON data for each section based on frontend structure
  personalInfo           Json?
  incomeInfo             Json?
  rentalIncome           Json?
  foreignIncome          Json?
  workRelatedExpenses    Json?
  specialExpenses        Json?
  extraordinaryBurdens   Json?
  craftsmenServices      Json?
  businessExpenses       Json?
  signature              Json?
  taxYear                Json?
  
  // Metadata fields
  submittedAt            DateTime?
  language               String    @default("en")
} 