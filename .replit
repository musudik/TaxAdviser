run = "bash ./replit-setup.sh"
entrypoint = "index.js"
hidden = [".config", "package-lock.json"]
modules = ["nodejs-20", "postgresql-16"]

[env]
POSTGRES_PASSWORD = "postgres"
DATABASE_URL = "postgresql://postgres:postgres@localhost:5432/taxadviser?sslmode=require"

[nix]
channel = "stable-22_11"

[deployment]
run = ["sh", "-c", "node backend/dist/main"]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "cd backend && npx prisma generate && npm run build"]

[languages]
[languages.javascript]
pattern = "**/{*.js,*.jsx,*.ts,*.tsx}"

[languages.javascript.languageServer]
start = "typescript-language-server --stdio"

[unitTest]
language = "nodejs"

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
author = 36293822
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm install && npm run start:dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm install && npm run dev"
