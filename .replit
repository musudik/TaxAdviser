run = "sh ./replit_start.sh"
language = "nodejs"
entrypoint = "replit_start.sh"
hidden = [".git", ".next", "node_modules", ".env"]
modules = ["nodejs-20:v8-20230920-bd784b9", "postgresql-16"]

[nix]
channel = "stable-23_05"

[packager]
language = "nodejs"

[packager.features]
packageSearch = true
guessImports = true

[env]
PORT_BACKEND = "3001"
PORT_FRONTEND = "5173"
NODE_ENV = "development"
VITE_API_URL = "http://localhost:3001/api"

[deployment]
run = ["sh", "-c", "cd backend && npm run start:prod"]
deploymentTarget = "cloudrun"
ignorePorts = false 
build = ["sh", "-c", "cd frontend && npm install && npm run build && cd ../backend && npm install && npm run build"]

[workflows]
runButton = "Dev"

[[workflows.workflow]]
name = "Dev"
author = 36293822
mode = "parallel"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && npm run start:dev"
